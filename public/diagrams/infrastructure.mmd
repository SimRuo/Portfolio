flowchart LR
    %% ───────── External ─────────
    user(["Visitor"])
    dns[("Namecheap DNS<br/>simruo.dev + *.simruo.dev")]
    le[("Let's Encrypt<br/>ACME / certbot")]

    user -- "HTTPS :443" --> router
    user -. "DNS lookup" .-> dns
    dns -. "A record" .-> router

    %% ───────── Home network ─────────
    subgraph HOME["Home network — ASUS TUF AX5400"]
        router["Router<br/>NAT + port forward 80/443"]
    end

    %% ───────── Server ─────────
    subgraph SERVER["ThinkCentre M910q — Ubuntu host"]
        certbot["certbot (host)<br/>webroot renewal"]
        le -. "ACME challenge" .-> certbot

        subgraph DOCKER["🐳 Docker Engine (everything below runs in containers)"]

            subgraph PROXY_NET["Docker bridge network: web-proxy"]
                nginx["🐳 nginx-proxy<br/>nginx:alpine<br/>TLS termination<br/>vhost routing<br/>HSTS / CSP / headers"]

                subgraph PORTFOLIO["Portfolio (docker-compose)"]
                    pfNginx["🐳 portfolio-frontend<br/>nginx:alpine + Vite build"]
                end

                subgraph LIFTLOG["LiftLog (docker-compose)"]
                    llClient["🐳 liftlog-client<br/>nginx:alpine<br/>React 19 PWA"]
                    llApi["🐳 liftlog-api<br/>ASP.NET Core + JWT"]
                    llDb[("🐳 liftlog-db<br/>mssql container<br/>+ named volume")]
                    llClient --> llApi --> llDb
                end

                subgraph SYNCIO["Syncio (docker-compose)"]
                    syApi["🐳 syncio<br/>.NET 8 + SignalR<br/>yt-dlp + FFmpeg"]
                    syFs[("named volume<br/>uploads / cache")]
                    syApi --> syFs
                end

                subgraph FOOD["FoodScraper (docker-compose)"]
                    fsClient["🐳 foodscraper-client<br/>React 19 + Nivo"]
                    fsApi["🐳 foodscraper-api<br/>FastAPI"]
                    fsScrape["🐳 foodscraper-worker<br/>Selenium + BS4"]
                    fsDb[("named volume<br/>scraped dataset")]
                    fsClient --> fsApi
                    fsApi --> fsDb
                    fsApi -. "live trigger" .-> fsScrape
                    fsScrape --> fsDb
                end

                subgraph THESIS["Thesis stack (docker-compose)"]
                    graf["🐳 grafana"]
                    otel["🐳 otel-collector"]
                    otel --> graf
                end

                nginx -- "simruo.dev" --> pfNginx
                nginx -- "liftlog.simruo.dev" --> llClient
                nginx -- "syncio.simruo.dev" --> syApi
                nginx -- "foodscraper.simruo.dev" --> fsClient
                nginx -- "grafana.simruo.dev" --> graf
            end
        end

        certbot -. "writes certs (bind mount)" .-> nginx
    end

    router --> nginx

    %% ───────── styling ─────────
    classDef ext fill:#1a1d24,stroke:#7c9aff,color:#e6e8ee;
    classDef infra fill:#13161d,stroke:#4a5060,color:#e6e8ee;
    classDef container fill:#0e2a47,stroke:#2496ed,color:#e6e8ee;
    classDef volume fill:#1a1d24,stroke:#f4a261,color:#e6e8ee;
    class user,dns,le ext;
    class router,certbot infra;
    class nginx,pfNginx,llClient,llApi,syApi,fsClient,fsApi,fsScrape,graf,otel,llDb container;
    class syFs,fsDb volume;
